# api/.htaccess
# ===================================================
# Rôle :
# - Front controller de l’API
# - Routage vers api/index.php
# - Protection minimale des fichiers internes
# ===================================================

RewriteEngine On
RewriteBase /api/

# Sécurité : empêcher l’indexation des répertoires
Options -Indexes

# Ne pas réécrire les fichiers ou dossiers existants
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Toutes les routes API passent par index.php
RewriteRule ^ index.php [QSA,L]

# Bloquer l’accès direct aux fichiers PHP, ini, log
<FilesMatch "\.(php|ini|log)$">
    Require all denied
</FilesMatch>

# Autoriser explicitement le point d’entrée API
<FilesMatch "^index\.php$">
    Require all granted
</FilesMatch>