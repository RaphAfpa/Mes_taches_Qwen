# api/.htaccess
RewriteEngine On
RewriteBase /api/

# Exclure les fichiers et répertoires existants de la réécriture
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Réécrire toutes les requêtes vers index.php (dans le dossier api/)
RewriteRule ^(.*)$ index.php [QSA,L]


php_flag log_errors On
php_flag display_errors On
php_value error_reporting E_ALL
php_value error_log "/home/ezoi4288/tdl.afpa21.fr/api/php_error.log"
